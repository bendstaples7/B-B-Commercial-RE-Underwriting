# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps / Places API (required for address autocomplete)
# Get a key at https://console.cloud.google.com — enable Maps JavaScript API and Places API
# Restrict by HTTP referrer for browser use. CI/deploy can also inject this via
# GitHub secret VITE_GOOGLE_MAPS_API_KEY, backend GOOGLE_MAPS_BROWSER_API_KEY,
# or GOOGLE_MAPS_API_KEY (see scripts/inject_google_maps_browser_key.py).
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: authenticated live-UI snapshots (agent visibility). Prefer putting these
# in the repo-root .env (gitignored). Never commit real passwords.
# BB_E2E_EMAIL=you@example.com
# BB_E2E_PASSWORD=your-local-password
# BB_E2E_SESSION_TOKEN=
# BB_LIVE_UI_BASE_URL=http://localhost:3000
# BB_LIVE_UI_API_URL=http://localhost:5000/api
